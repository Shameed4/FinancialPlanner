// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TaxBrackets {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventSeries {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  scenario    Scenario @relation(fields: [scenarioId], references: [id])
  scenarioId  Int

  // Start Year Logic
  startYearType        StartYearType
  startYear            Int? // Fixed year
  startMin             Int? // Random uniform (min)
  startMax             Int? // Random uniform (max)
  startMean            Float? // Random normal (mean)
  startStd             Float? // Random normal (std dev)
  startOnOtherSeriesId Int? // References another EventSeries for same_as/after
  startOnOtherSeries   EventSeries?  @relation("SameStartYear", fields: [startOnOtherSeriesId], references: [id])
  relatedEventSeries   EventSeries[] @relation("SameStartYear")

  // Duration Logic
  durationType DistributionType
  duration     Int? // Fixed duration
  durationMin  Int? // Random uniform (min)
  durationMax  Int? // Random uniform (max)
  durationMean Float? // Random normal (mean)
  durationStd  Float? // Random normal (std dev)

  // Details
  type EventType

  // Relations to details
  incomeEventDetails    IncomeEventDetails?
  expenseEventDetails   ExpenseEventDetails?
  investEventDetails    InvestEventDetails?
  rebalanceEventDetails RebalanceEventDetails?
}

enum StartYearType {
  fixed
  random_uniform
  random_normal
  same_as
  after
}

enum DistributionType {
  fixed
  percentage
  random_uniform
  random_normal
}

enum EventType {
  income
  expense
  invest
  rebalance
}

model IncomeEventDetails {
  id                     Int              @id @default(autoincrement())
  initialAmount          Float
  annualChangeType       DistributionType
  changeAmtOrPct         AmountOrPercent
  annualChangeAmount     Float? // Can be a fixed amount or percentage for fixed
  annualChangePercentage Float? // Can be a fixed amount or percentage for fixed
  annualChangeMin        Float? // for random_uniform
  annualChangeMax        Float? // for random_uniform
  annualChangeMean       Float? // for random_normal
  annualChangeStd        Float? // for random_normal

  inflationAdjustment Boolean
  userPercentage      Float?
  spousePercentage    Float?

  isSocialSecurity Boolean

  // Relation to EventSeries
  eventSeries   EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  eventSeriesId Int         @unique
}

model ExpenseEventDetails {
  id                     Int              @id @default(autoincrement())
  initialAmount          Float
  annualChangeType       DistributionType
  changeAmtOrPct         AmountOrPercent
  annualChangeAmount     Float? // Can be a fixed amount or percentage for fixed
  annualChangePercentage Float? // Can be a fixed amount or percentage for fixed
  annualChangeMin        Float? // for random_uniform
  annualChangeMax        Float? // for random_uniform
  annualChangeMean       Float? // for random_normal
  annualChangeStd        Float? // for random_normal

  inflationAdjustment Boolean
  userPercentage      Float?
  spousePercentage    Float?

  isDiscretionary  Boolean
  spendingStrategy Int? // for the spending strategy of discretionary expenses

  // Relation to EventSeries
  eventSeries   EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  eventSeriesId Int         @unique
}

model InvestEventDetails {
  id                Int    @id @default(autoincrement())
  maxCash           Float
  initialAllocation Float // used for both fixed and glide paths
  finalAllocation   Float? // used only for glide paths

  // Relation to EventSeries
  eventSeries     EventSeries       @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  eventSeriesId   Int               @unique
  AssetAllocation AssetAllocation[] @relation()
}

model RebalanceEventDetails {
  id              Int               @id @default(autoincrement())
  // Relation to EventSeries
  eventSeries     EventSeries       @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  eventSeriesId   Int               @unique
  AssetAllocation AssetAllocation[]
}

model AssetAllocation {
  aId                     Int                    @id @default(autoincrement())
  investment              Investment             @relation(references: [id], fields: [investmentId], onDelete: Cascade)
  investmentId            Int
  investEventDetails      InvestEventDetails?    @relation(references: [id], fields: [investEventDetailsId], onDelete: Cascade)
  investEventDetailsId    Int?
  rebalanceEventDetails   RebalanceEventDetails? @relation(references: [id], fields: [rebalanceEventDetailsId], onDelete: Cascade)
  rebalanceEventDetailsId Int?
  initialAllocation       Float
  finalAllocation         Float?

  // @@unique([investmentId, rebalanceEventDetailsId, investEventDetailsId])
}

model AssetType {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  returnType       ReturnType
  fixedReturn      Float? // for fixed
  normalReturnMean Float? // for normal
  normalReturnStd  Float? // for normal
  returnAmtOrPct   AmountOrPercent

  expectedAnnualIncomeType ReturnType
  fixedIncome              Float?
  normalIncomeMean         Float?
  normalIncomeStd          Float?
  incomeAmtOrPct           AmountOrPercent

  expenseRatio Float
  taxability   Taxability
  investments  Investment[]
}

model Investment {
  id                        Int                  @id @default(autoincrement())
  assetType                 AssetType            @relation(fields: [assetTypeId], references: [id])
  assetTypeId               Int
  value                     Float
  taxStatus                 TaxStatus
  rothConversionStrategy    Int? // for pre tax investments
  rmdStrategy               Int?
  expenseWithdrawalStrategy Int
  assetAllocations          AssetAllocation[]
  investmentScenario        InvestmentScenario[]
}

enum ReturnType {
  FIXED
  NORMAL
}

enum TaxStatus {
  NON_RETIREMENT
  PRE_TAX_RETIREMENT
  AFTER_TAX_RETIREMENT
}

enum Taxability {
  TAXABLE
  TAX_EXEMPT
}

model RMD {
  id                 Int   @id @default(autoincrement())
  year               Int
  age                Int
  distributionPeriod Float
}

model Scenario {
  id                       Int     @id @default(autoincrement())
  name                     String
  financialGoal            Int
  forIndividual            Boolean
  userBirthYear            Int
  userLifeExpectancyMean   Float
  userLifeExpectancyStd    Float   @default(0)
  spouseBirthYear          Int?
  spouseLifeExpectancyMean Int?
  spouseLifeExpectancyStd  Float?

  investmentScenario InvestmentScenario[]
  eventSeries        EventSeries[]

  inflationAssumption DistributionType
  inflation           Float? // for fixed
  inflationMin        Float? // for random_uniform
  inflationMax        Float? // for random_uniform
  inflationMean       Float? // for random_normal
  inflationStd        Float? // for random_normal

  ownerPrivilege     User   @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId            String
  readonlyPrivilege  User[] @relation("readonly")
  readwritePrivilege User[] @relation("readwrite")

  initialAfterTaxRetirementContributionLimit Int

  rothOptimizationStartYear Int?
  rothOptimizationEndYear   Int?

  residenceState State
}

model InvestmentScenario {
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId Int
  scenario     Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId   Int

  @@id([investmentId, scenarioId])
}

model User {
  id                 String         @id // id
  googleId           String
  stateBrackets      StateBracket[] @relation("userBrackets")
  ownedScenarios     Scenario[]     @relation("owner")
  readonlyScenarios  Scenario[]     @relation("readonly")
  readwriteScenarios Scenario[]     @relation("readwrite")
}

model StateBracket {
  id      Int    @id @default(autoincrement())
  state   State
  bracket Int
  User    User   @relation("userBrackets", fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  rate    Float

  @@unique([state, bracket, userId])
}

enum AmountOrPercent {
  amount
  percent
}

model RMDTable {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

