model AssetType {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  returnType          ReturnType
  fixedReturn         Float? // for fixed
  normalReturnMean    Float? // for normal
  normalReturnStd     Float? // for normal

  expectedAnnualIncomeType ReturnType
  fixedIncome              Float?
  normalIncomeMean         Float?
  normalIncomeStd          Float?
  gbmIncomeDrift           Float?
  gbmIncomeVolatility      Float?

  expenseRatio Float
  taxability   Taxability
  investments  Investment[]
}

model Investment {
  id                     Int                  @id @default(autoincrement())
  assetType              AssetType            @relation(fields: [assetTypeId], references: [id])
  assetTypeId            Int
  value                  Float
  taxStatus              TaxStatus
  rothConversionStrategy Int? // for pre tax investments
  assetAllocations       AssetAllocation[]
  investmentScenario     InvestmentScenario[]
}

enum ReturnType {
  FIXED
  NORMAL
}

enum TaxStatus {
  NON_RETIREMENT
  PRE_TAX_RETIREMENT
  AFTER_TAX_RETIREMENT
}

enum Taxability {
  TAXABLE
  TAX_EXEMPT
}
